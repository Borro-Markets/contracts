pragma solidity 0.8.28;

/// Generated by a Python script from the operating system's time zone database (zoneinfo, America/New_York) and the
/// exchange calendar (~/stock-hours-kit/contracts/data/nyse-calendar.json): 10205 moments from 2026-01-01 to 2029-03-31
/// (6808 open), each as a 4-byte Unix time and a 1-byte answer. Every 20:00 New York boundary on every date (one
/// hour and one second either side, and on it), midday and 03:30 every date, 60 hours around each daylight saving
/// switch, and 1,500 random moments. The reference reads a holiday only from the 2026 to 2028 list, as the library does.
library MarketHoursCases {
    uint256 internal constant COUNT = 10205;
    bytes internal constant CASES = hex"";
}
